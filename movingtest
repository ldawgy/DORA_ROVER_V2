
bool ballSeen = false;

// 电机引脚定义 - 请根据您的实际硬件接线修改这些引脚
// 假设使用L298N电机驱动模块
const int ENA = 2;    // 左电机使能引脚 (PWM)
const int IN1 = 3;    // 左电机控制引脚1
const int IN2 = 4;    // 左电机控制引脚2
const int IN3 = 5;    // 右电机控制引脚1
const int IN4 = 6;    // 右电机控制引脚2
const int ENB = 7;    // 右电机使能引脚 (PWM)

// 电机速度设置 (0-255)
const int motorSpeed = 150;      // 正常前进速度
const int turnSpeed = 120;       // 转弯速度
const int patrolSpeed = 100;     // 巡逻模式速度

// 巡逻模式状态变量
unsigned long lastPatrolTime = 0;
int patrolState = 0;
const unsigned long patrolInterval = 2000; // 巡逻状态切换间隔(ms)

void setup() {
  Serial.begin(9600); 
  
  // 初始化电机控制引脚
  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  pinMode(ENB, OUTPUT);
  
  // 初始状态：停止所有电机
  stopMotors();
  
  while (!Serial) {
    ; // Wait for serial port to connect. Needed for native USB port only
  }
  Serial.println("Ready to receive data.");
  Serial.println("Motor control initialized.");
}

void loop() {
  if (Serial.available() > 0) {
    byte receivedByte = Serial.read(); 
    
    if(receivedByte == 0) {
      ballSeen = false; 
      Serial.println("...patrol mode");
      // 进入巡逻模式
      patrolMode();
    }
    
    if(receivedByte == 2) {
      Serial.println("Ball seen! Go straight!");
      ballSeen = true;  
      moveForward();
    }
    
    if(receivedByte == 3) {
      Serial.println("Ball seen! Turn right and go forward");
      ballSeen = true;  
      turnRightForward();
    }
    
    if(receivedByte == 4) {
      Serial.println("Ball seen! Turn left and go forward");
      ballSeen = true;  
      turnLeftForward();
    }

    // 添加对其他指令的支持（根据您的字节映射）
    if(receivedByte == 5) {
      Serial.println("Turn left and go backward");
      turnLeftBackward();
    }
    
    if(receivedByte == 6) {
      Serial.println("Go backward");
      moveBackward();
    }
    
    if(receivedByte == 7) {
      Serial.println("Turn right and go backward");
      turnRightBackward();
    }
    
    if(receivedByte == 8) {
      Serial.println("Stop");
      stopMotors();
    }
  }

  // 如果在巡逻模式且没有看到球，执行巡逻行为
  if (!ballSeen) {
    patrolMode();
  }
}

// ========== 电机控制函数 ==========

// 停止所有电机
void stopMotors() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
  analogWrite(ENA, 0);
  analogWrite(ENB, 0);
}

// 前进
void moveForward() {
  // 左电机前进
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  // 右电机前进
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  // 设置速度
  analogWrite(ENA, motorSpeed);
  analogWrite(ENB, motorSpeed);
}

// 后退
void moveBackward() {
  // 左电机后退
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  // 右电机后退
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
  // 设置速度
  analogWrite(ENA, motorSpeed);
  analogWrite(ENB, motorSpeed);
}

// 原地右转
void turnRight() {
  // 左电机前进
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  // 右电机后退
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
  // 设置速度
  analogWrite(ENA, turnSpeed);
  analogWrite(ENB, turnSpeed);
}

// 原地左转
void turnLeft() {
  // 左电机后退
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  // 右电机前进
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  // 设置速度
  analogWrite(ENA, turnSpeed);
  analogWrite(ENB, turnSpeed);
}

// 右转并前进（弧线运动）
void turnRightForward() {
  // 两个电机都前进
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  // 左电机全速，右电机半速，产生右转弧线
  analogWrite(ENA, motorSpeed);
  analogWrite(ENB, turnSpeed);
}

// 左转并前进（弧线运动）
void turnLeftForward() {
  // 两个电机都前进
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  // 左电机半速，右电机全速，产生左转弧线
  analogWrite(ENA, turnSpeed);
  analogWrite(ENB, motorSpeed);
}

// 右转并后退
void turnRightBackward() {
  // 两个电机都后退
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
  // 左电机全速，右电机半速
  analogWrite(ENA, motorSpeed);
  analogWrite(ENB, turnSpeed);
}

// 左转并后退
void turnLeftBackward() {
  // 两个电机都后退
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
  // 左电机半速，右电机全速
  analogWrite(ENA, turnSpeed);
  analogWrite(ENB, motorSpeed);
}

// 巡逻模式
void patrolMode() {
  unsigned long currentTime = millis();
  
  if (currentTime - lastPatrolTime >= patrolInterval) {
    lastPatrolTime = currentTime;
    
    // 切换到下一个巡逻状态
    patrolState = (patrolState + 1) % 4;
    
    switch (patrolState) {
      case 0:
        Serial.println("Patrol: Moving forward");
        moveForwardPatrol();
        break;
      case 1:
        Serial.println("Patrol: Turning right");
        turnRightPatrol();
        break;
      case 2:
        Serial.println("Patrol: Moving forward");
        moveForwardPatrol();
        break;
      case 3:
        Serial.println("Patrol: Turning left");
        turnLeftPatrol();
        break;
    }
  }
}

// 巡逻模式下的前进
void moveForwardPatrol() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  analogWrite(ENA, patrolSpeed);
  analogWrite(ENB, patrolSpeed);
}

// 巡逻模式下的右转
void turnRightPatrol() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
  analogWrite(ENA, patrolSpeed);
  analogWrite(ENB, patrolSpeed);
}

// 巡逻模式下的左转
void turnLeftPatrol() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  analogWrite(ENA, patrolSpeed);
  analogWrite(ENB, patrolSpeed);
}



